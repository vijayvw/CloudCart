aws_region   = "us-east-1"
project_name = "CloudCart-Native"
environment  = "dev"

# VPC network configuration
vpc_cidr              = "10.30.0.0/16"
public_subnet_cidr    = "10.30.1.0/24"
private_subnet_1_cidr = "10.30.2.0/24"
private_subnet_2_cidr = "10.30.3.0/24"

# EC2 configuration
instance_type = "t3.micro"

# Existing AWS EC2 Key Pair name
key_name = "your-key-pair-name"

# RDS configuration
db_name     = "cloud_cart_project"
db_username = "admin"
db_password = "CHANGE_ME"

# DynamoDB configuration
dynamodb_table_name = "Cloud_Users"

# GitHub repository configuration
github_repo   = "https://github.com/vijayvw/CloudCart.git"
github_branch = "main"
