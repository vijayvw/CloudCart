# ---------------------------------------------------------
# KuCL Mini Project - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------

# AWS credentials (or use an IAM role / instance profile instead)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS RDS (MySQL) connection details
RDS_HOST=kucl-mini-project.xxxxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=kucl_mini_project
RDS_USER=admin
RDS_PASSWORD=your_rds_password_here

# DynamoDB table used for storing user details (NoSQL)
DYNAMODB_USERS_TABLE=KuCL_Users
DYNAMODB_ENDPOINT=
